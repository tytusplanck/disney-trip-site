---
import { allTripsData } from '../../data/all-trips';
import { findTripDataModule, findTripSummary, getTripLandingPath } from '../../lib/trips/all-trips';

const tripSlug = Astro.params['trip'] ?? '';
const trip = findTripSummary(allTripsData.trips, tripSlug);
const redirectPath = trip
  ? getTripLandingPath(trip, findTripDataModule(allTripsData.modules, tripSlug))
  : '/';

// astro check only counts reads inside a branch, so the redirect stays in one.
if (redirectPath) {
  return Astro.redirect(redirectPath);
}
---
