---
import PackingLists from '../../components/PackingLists';
import TripPageShell from '../../components/shells/TripPageShell.astro';
import { allTripsData } from '../../data/all-trips';
import { getTripLandingPath, getTripRouteContext } from '../../lib/trips/all-trips';
import { hasTripSectionContent } from '../../lib/trips/readiness';
import '../../styles/packing.css';
import { tripSectionCopy } from './trip-sections.page';

const context = getTripRouteContext(
  allTripsData.trips,
  allTripsData.modules,
  Astro.params['trip'] ?? '',
);
const packing = context?.tripModule.packing;
const redirectPath = !context
  ? '/'
  : !packing ||
      !hasTripSectionContent(context.tripModule, 'packing') ||
      !context.sectionConfig.some((tab) => tab.section === 'packing')
    ? getTripLandingPath(context.trip, context.tripModule)
    : null;
if (redirectPath || !context || !packing) return Astro.redirect(redirectPath ?? '/');
const { trip, sectionConfig } = context;
const pageCopy = tripSectionCopy.packing;
---

<TripPageShell
  title={`${trip.title} | Packing`}
  description={`Packing recommendations for ${trip.title}.`}
  trip={trip}
  activeSection="packing"
  sectionConfig={sectionConfig}
  pageTitle={pageCopy.title}
  pageSummary={pageCopy.summary}
  print={pageCopy.print}
>
  <PackingLists data={packing} client:load />
</TripPageShell>
